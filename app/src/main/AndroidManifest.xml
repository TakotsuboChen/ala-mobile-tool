<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        miuix-blur 声明的 minSdk=33（用 RenderEffect），但库内部 isRenderEffectSupported()
        已在 Android 12+ 之外返回 false，运行时安全。照搬 KernelSU 的处理方式：
        tools:overrideLibrary 允许 minSdk 26 的模块继续链接。
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        NPatch 配置同步：模块进程（ConfigActivity）通过 ContentResolver.call
        调 content://top.nkbe.npatch.remote 拿可写 IXposedService binder，
        把配置写进 NPatch 管理器的 NPatchRemoteStore；游戏进程的
        getRemotePreferences() 经 ManagerRemoteServiceBridge 读同一份。
        Android 11+ 包可见性要求显式声明 queries 才能 resolve 到 NPatch 的
        ContentProvider（模块没有也不该申请 QUERY_ALL_PACKAGES）。
    -->
    <queries>
        <package android:name="top.nkbe.npatch" />
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposedminversion"
            android:value="102" />

        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".ConfigActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AlaMobileTool">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            跨进程配置 IPC。游戏进程（LSPosed 注入的代码）通过 ContentResolver
            调 READ_METHOD，Binder 路由到模块进程读取 filesDir 配置，绕开 Android 11+
            scoped storage 对跨进程文件访问的限制。导出给游戏进程访问。
        -->
        <provider
            android:name=".config.ConfigProvider"
            android:authorities="tools.alamobile.mod.config"
            android:exported="true" />
    </application>

</manifest>
